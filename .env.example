APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Comma-separated browser origins that can call api/unlock on Vercel.
# The WordPress embed origin below is allowed by default in code, but keeping it
# here makes deployment config explicit.
ALLOWED_ORIGINS=https://industryhub.rmit.edu.vn

# Set to true in local/dev to short-circuit /api/unlock
# and skip the Google Sheets write completely.
BYPASS_UNLOCK_STORAGE=true
